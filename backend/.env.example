# ==============================================================================
# StockFlow Backend Environment Variables Template (.env.example)
# Copy this file to '.env' and populate with your actual values.
# Real credentials must NEVER be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Production Secret Key (set DJANGO_SECRET_KEY in Render environment variables)
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production
# Local fallback key variable:
SECRET_KEY=django-insecure-change-this-to-a-secure-random-secret-key-in-production

# Set DEBUG=False for production deployment (defaults to False if RENDER is detected)
DEBUG=False

# Comma-separated list of allowed hostnames (Render automatically adds RENDER_EXTERNAL_HOSTNAME)
ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# CORS Origins Settings
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. web frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
# In production, CORS_ALLOW_ALL_ORIGINS defaults to False
CORS_ALLOW_ALL_ORIGINS=False

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Database engine selector:
#   - Set to 'postgresql' (or 'postgres') to connect to Supabase PostgreSQL.
#   - Set to 'mysql' (or omit DB_ENGINE) to use local MySQL for development.
DB_ENGINE=postgresql

# ------------------------------------------------------------------------------
# Option A: Supabase PostgreSQL (Discrete Variables)
# ------------------------------------------------------------------------------
# 1. Transaction Pooler (Recommended - Port 6543, supports IPv4 & serverless):
#    Host: aws-0-[REGION].pooler.supabase.com (find in Supabase Dashboard -> Database Settings)
#    Port: 6543
#    User: postgres.[YOUR-PROJECT-REF]
#    Name: postgres
#    SSL:  require
#
# 2. Direct Connection (Port 5432 - Requires IPv4 add-on or IPv6 network):
#    Host: db.[YOUR-PROJECT-REF].supabase.co
#    Port: 5432
#    User: postgres
#    Name: postgres
#    SSL:  require

DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-supabase-database-password
DB_SSLMODE=require
DB_CONN_MAX_AGE=0

# ------------------------------------------------------------------------------
# Option B: Supabase PostgreSQL (Single DATABASE_URL Connection String)
# ------------------------------------------------------------------------------
# If DATABASE_URL is set, it takes precedence over discrete DB_* variables.
#
# Transaction Pooler URI:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct Connection URI:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# DATABASE_URL=

# ------------------------------------------------------------------------------
# Option C: Local MySQL Development Fallback
# ------------------------------------------------------------------------------
# To switch to your existing local MySQL database, set DB_ENGINE=mysql:
# Option C1: Prefix-based (allows co-existence with Supabase DB_* settings):
# MYSQL_NAME=inventory_db
# MYSQL_USER=root
# MYSQL_PASSWORD=your_local_mysql_password
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
#
# Option C2: Standard generic variables:
# DB_ENGINE=mysql
# DB_NAME=inventory_db
# DB_USER=root
# DB_PASSWORD=your_local_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3307
