<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_upcoming_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stockflow_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_upcoming_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 Upcoming 7 Days"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_upcoming_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next 7 Days"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_upcoming_btn_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="+ Add"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/widget_upcoming_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/widget_upcoming_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No upcoming tasks next 7 days"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_upcoming_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All caught up • Tap to open app"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_upcoming_empty_btn_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="+ Add Task"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Upcoming Tasks Container (up to 4 tasks shown) -->
    <LinearLayout
        android:id="@+id/widget_upcoming_tasks_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Task Item 1 -->
        <LinearLayout
            android:id="@+id/upcoming_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/upcoming_date_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomorrow "
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/upcoming_check_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ "
                android:textColor="#60A5FA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/upcoming_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Task Title"
                android:textColor="#F1F5F9"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/upcoming_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Task Item 2 -->
        <LinearLayout
            android:id="@+id/upcoming_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/upcoming_date_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomorrow "
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/upcoming_check_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ "
                android:textColor="#60A5FA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/upcoming_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Task Title"
                android:textColor="#F1F5F9"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/upcoming_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:00"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Task Item 3 -->
        <LinearLayout
            android:id="@+id/upcoming_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/upcoming_date_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomorrow "
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/upcoming_check_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ "
                android:textColor="#60A5FA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/upcoming_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Task Title"
                android:textColor="#F1F5F9"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/upcoming_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:00"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Task Item 4 -->
        <LinearLayout
            android:id="@+id/upcoming_item_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/upcoming_date_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomorrow "
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/upcoming_check_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ "
                android:textColor="#60A5FA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/upcoming_title_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Task Title"
                android:textColor="#F1F5F9"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/upcoming_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:00"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Remaining count -->
        <TextView
            android:id="@+id/upcoming_remaining_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 2 more tasks"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:layout_marginTop="1dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
